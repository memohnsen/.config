layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:/Users/maddisenmohnsen/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}{tabs}"
                format_center ""
                format_right  "{datetime}"
                format_space  "#[bg=#1E222A]"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#1E222A,bg=#1E222A]{char}"
                border_position "top"

                mode_normal  "#[fg=#282C34,bg=#98C379,bold] UNLOCKED "
                mode_locked  "#[fg=#FFFFFF,bg=#E06C75,bold] LOCKED "

                tab_normal   "#[fg=#5C6370,bg=#1E222A] {index} {name} "
                tab_active   "#[fg=#ABB2BF,bg=#1E222A,bold,italic] {index} {name} "
                tab_separator ""
            }
        }
    }

    tab name="scratch" focus=false {
    }

    tab name="nvim" focus=true {
        pane split_direction="vertical" {
            pane command="fish" size="60%" {
                args "-lc" "nvim; exec fish -l"
            }
            pane command="fish" size="40%" {
            }
        }
    }
}
