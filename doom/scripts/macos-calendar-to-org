#!/usr/bin/env zsh
set -euo pipefail

out="${1:-$HOME/dev/org/calendar.org}"
days="${2:-14}"
include_re="${3:-^(memohnsen@gmail\\.com|Teamworks H2F|P&G|P&G Meet Calendar|Home)$}"

mkdir -p "$(dirname "$out")"
tmp="$(mktemp "$(dirname "$out")/.calendar.org.XXXXXX")"
script_dir="${0:A:h}"
helper_app="$script_dir/macos-calendar-to-org-helper.app"
helper_contents="$helper_app/Contents"
helper_macos="$helper_contents/MacOS"
helper="$helper_macos/macos-calendar-to-org-helper"
source_file="$script_dir/macos-calendar-to-org.swift"
plist_file="$script_dir/macos-calendar-to-org-info.plist"
trap 'rm -f "$tmp"' EXIT

if [[ ! -x "$helper" || "$source_file" -nt "$helper" || "$plist_file" -nt "$helper" ]]; then
  mkdir -p "$helper_macos"
  cp "$plist_file" "$helper_contents/Info.plist"
  /usr/bin/swiftc -o "$helper" "$source_file"
  /usr/bin/codesign --force --sign - "$helper_app" >/dev/null 2>&1 || true
fi

/usr/bin/open -W -n "$helper_app" --args "$days" "$include_re" "$tmp"
chmod 0644 "$tmp"
mv "$tmp" "$out"
printf 'Wrote %s\n' "$out"
