// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ssh_connections": [
    {
      "host": "2.25.146.237",
      "username": "maddisen",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/maddisen/dev/meetcal-llc/meetcal-backend"
          ]
        }
      ]
    }
  ],
  "helix_mode": false,
  "cli_default_open_behavior": "existing_window",
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "prettier": {
    "allowed": true,
  },
  "soft_wrap": "editor_width",
  "edit_predictions": {
    "provider": "zed",
  },
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tabs": {
    "git_status": false,
    "file_icons": false,
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true,
    "show": true,
  },
  "title_bar": {
    "show_branch_name": true,
    "show_project_items": true,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_menus": true,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false,
  },
  "extend_comment_on_newline": false,
  "debugger": {
    "button": false,
  },
  "search": {
    "button": true,
  },
  "diagnostics": {
    "button": true,
  },
  "terminal": {
    "dock": "bottom",
    "button": true,
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": false,
  },
  "auto_signature_help": false,
  "project_panel": {
    "dock": "left",
    "button": true,
  },
  "show_edit_predictions": false,
  "jsx_tag_auto_close": {
    "enabled": true,
  },
  "git_panel": {
    "dock": "left",
    "collapse_untracked_diff": false,
  },
  "word_diff_enabled": true,
  "diff_view_style": "unified",
  "scrollbar": {
    "git_diff": true,
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "cursor": {
      "favorite_config_option_values": {
        "model": [
          "composer-2[fast=true]",
          "gpt-5.4[reasoning=medium,context=272k,fast=false]"
        ],
      },
      "type": "registry",
    },
  },
  "agent": {
    "flexible": true,
    "dock": "left",
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "moonshotai/kimi-k2.5",
      "enable_thinking": true,
    },
    "default_model": {
      "provider": "openrouter",
      "model": "anthropic/claude-opus-4.6",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "moonshotai/kimi-k2.5",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "anthropic/claude-opus-4.6",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "anthropic/claude-sonnet-4.6",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "openrouter/free",
        "enable_thinking": true,
      },
      {
        "provider": "openrouter",
        "model": "openrouter/auto",
        "enable_thinking": true,
      },
    ],
    "model_parameters": [],
  },
  "disable_ai": false,
  "calls": {
    "mute_on_join": true,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 4,
  "vim": {
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 200,
  },
  "icon_theme": "Catppuccin Latte",
  "base_keymap": "Cursor",
  "ui_font_size": 16,
  "buffer_font_size": 14.0,
  "theme": "VSCode Dark Modern",
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
}
